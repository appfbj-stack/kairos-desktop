{
  "name": "kairos-core",
  "version": "0.1.0",
  "description": "Kairos AI Core - LLM Bridge + Memory + Skills orchestrator",
  "type": "module",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.core.json",
    "start": "node dist/server.js",
    "test:openrouter": "tsx --env-file=../.env ../tests/integration/test-openrouter.ts",
    "test:memory": "tsx ../tests/integration/test-memory.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0",
    "openai": "^4.71.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
