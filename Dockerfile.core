# Kairos Core - Dockerfile (multi-stage)
# Build: docker build -f Dockerfile.core -t kairos-core .
# Run:   docker run -p 4098:4098 --env-file .env kairos-core

# ============ STAGE 1: Build core (TS) + renderer (Vite) ============
# node:22+ (porque core usa node:sqlite que e experimental ate 22.5 e stable no 23+)
FROM node:22-alpine AS builder
WORKDIR /app

# Deps do root (Fastify, openai, sqlite, etc.)
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund

# Build core (TS -> dist/core/)
COPY core ./core
COPY tsconfig.core.json ./
RUN npx tsc -p tsconfig.core.json

# Build renderer (Vite -> dist/renderer/)
COPY src/renderer ./src/renderer
COPY src/shared ./src/shared
COPY vite.config.ts ./
COPY tsconfig.json ./
COPY index.html ./
RUN npx vite build

# ============ STAGE 2: Runtime ============
# Usa node:22-slim (Debian) ao inves de alpine para ter LibreOffice via apt-get
# (LibreOffice nao tem pacote oficial Alpine)
FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
# node:sqlite vira estavel no Node 23+, ate la precisa de flag
ENV NODE_OPTIONS=--experimental-sqlite

# Instala LibreOffice headless (writer + calc cobrem DOCX, XLSX, RTF, TXT, MD, etc)
# + poppler-utils (pdftotext) + tini (signal handling) + fonts basicas
# + deps de sistema que o Playwright precisa pra rodar Chromium headless
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-core \
    poppler-utils \
    tini \
    fontconfig \
    fonts-dejavu-core \
    fonts-liberation \
    # Playwright Chromium deps
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libxkbcommon0 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -f

# Instala só prod deps (mais leve)
COPY package.json package-lock.json* ./
RUN npm install --omit=dev --no-audit --no-fund

# Instala o Chromium do Playwright (~170MB, em vez de baixar Puppeteer ou apt install)
# PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright = default, mas explicito pra clareza
ENV PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
RUN npx playwright install chromium

# Copia o build do stage anterior
COPY --from=builder /app/dist ./dist

# Copia os templates HTML (tsc nao copia .html, mas as skills de visual/igreja precisam)
COPY --from=builder /app/core/templates /app/dist/core/templates

# Volume para SQLite (persiste entre deploys)
RUN mkdir -p /app/data
VOLUME ["/app/data"]

ENV KAIROS_HOST=0.0.0.0
ENV KAIROS_PORT=4098
ENV KAIROS_DB_PATH=/app/data/kairos.db
ENV KAIROS_STATIC_DIR=/app/dist/renderer

EXPOSE 4098
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4098/health || exit 1

# tini = init correto, soffice funciona melhor com tini (signal handling)
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/core/server.js"]
