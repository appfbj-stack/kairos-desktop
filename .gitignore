# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Electron
.cache/

# Environment
.env
.env.local
.env.*.local
*.pem

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Editor
.vscode/
!.vscode/settings.json.example
!.vscode/launch.json.example
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS
desktop.ini
ehthumbs.db

# Kairos user data (local)
.kairos/
kairos-data/

# Pastas deprecated (criadas por engano durante scaffold)
*.deprecated/

# OpenSquad runtime (downloaded at first run)
opensquad/_runtime/
opensquad/.opensquad-version

# Test artifacts
test-results/
playwright-report/
playwright/.cache/

# Sensitive
secrets/
*.key
*.crt

# Test build output
.test-build/

# Diagnostic marker (escrito pelo preload pra confirmar execucao)
.preload-ran.flag

# TypeScript build artifacts (são gerados pelo tsc, nao devem ir pro git)
core/**/*.js
core/**/*.js.map
core/**/*.d.ts
src/shared/**/*.js
src/shared/**/*.js.map
src/shared/**/*.d.ts
src/renderer/postcss.config.cjs
