# =====================================================
# Kairos Desktop AI - Environment Variables (example)
# =====================================================
# Copy this file to `.env` and fill in your keys.
# NEVER commit `.env` to git (already in .gitignore).

# ---------- LLM Providers ----------
# OpenRouter: https://openrouter.ai/keys (recommended, 1 key = 200+ models)
OPENROUTER_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Ollama: local LLM server, no key needed
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Default model per provider ----------
# Politica FREE-FIRST (2026-08-08): Kairos prefere modelos :free do OpenRouter.
# O default abaixo eh estavel (~16s), suporta tools e tem custo zero.
# Outros free estaveis (ordem de fallback automatico):
#   - nvidia/nemotron-3-super-120b-a12b:free  (default - 120B, 16s)
#   - nvidia/nemotron-3-ultra-550b-a55b:free  (550B, mais lento)
#   - openai/gpt-oss-20b:free                  (20B, rapido)
#   - google/gemma-4-26b-a4b-it:free          (26B, alternativa)
# Modelos pagos (gpt-4o, claude, etc) exigem creditos na conta OpenRouter.
# Modelos unstable (gemma-4-31b) sao pulados no auto-fallback.
KAIROS_DEFAULT_PROVIDER=openrouter
KAIROS_DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---------- Kairos AI Core ----------
KAIROS_PORT=4096
KAIROS_LOG_LEVEL=info
KAIROS_DATA_DIR=~/.kairos

# ---------- Auto-update server ----------
# Servidor de updates em kairosdesktop.fbautomacao.space (VPS Dokploy)
# Quando a Fase 8 for implementada, os instaladores serao hospedados aqui
KAIROS_UPDATE_SERVER=https://kairosdesktop.fbautomacao.space/api/updates
KAIROS_UPDATE_CHANNEL=stable
KAIROS_DOWNLOAD_BASE=https://kairosdesktop.fbautomacao.space/downloads
KAIROS_PUBLIC_URL=https://kairosdesktop.fbautomacao.space

# ---------- Telemetry (opt-in) ----------
KAIROS_TELEMETRY=off

# ---------- OpenSquad bundled ----------
# Download URL of OpenSquad to bundle inside Kairos
OPENSQUAD_VERSION=0.1.14
OPENSQUAD_REPO=renatoasse/opensquad
